# Vivado transient files and logs
.Xil/
*.jou
*.log
*.str
*.wdb
*.vcd
*.pb
*.backup.*
*.zip

# Vivado generated project data
/Multi_protocol.cache/
/Multi_protocol.gen/
/Multi_protocol.hw/
/Multi_protocol.ip_user_files/
/Multi_protocol.runs/
/Multi_protocol.sim/
/xsim.dir/

# Most of .srcs is generated. Keep only the BD source and its top wrapper so
# a clone can open Multi_protocol.xpr directly; all IP output products can be
# regenerated by Vivado.
/Multi_protocol.srcs/**
!/Multi_protocol.srcs/sources_1/
!/Multi_protocol.srcs/sources_1/bd/
!/Multi_protocol.srcs/sources_1/bd/multi_protocol_bd/
!/Multi_protocol.srcs/sources_1/bd/multi_protocol_bd/multi_protocol_bd.bd
!/Multi_protocol.srcs/sources_1/bd/multi_protocol_bd/hdl/
!/Multi_protocol.srcs/sources_1/bd/multi_protocol_bd/hdl/multi_protocol_bd_wrapper.v

# Generated implementation and hardware/software binaries
*.bit
*.bin
*.dcp
*.elf
*.hdf
*.hwdef
*.hwh

# Xilinx SDK/Eclipse workspaces and local tool state
/Multi_protocol.sdk/
/Multi_protocol.sdk_build/
/.sdk*/
/.java_home/
/.xilinx_user/
.metadata/
RemoteSystemsTempFiles/

# Automated validation, simulation, migration and download scratch areas
/.sim_*/
/_sim_*/
/_jtag_tmp/
/_migration_backup/
/artifacts/
/-p/
/reports/

# Obsolete local project/build remnants
/Multi_protocol.empty.*/
/download_candidate_jtag.tcl
/HANDOFF_*.md
*.bak
*.before_*

# Editor/OS files
.DS_Store
Thumbs.db
*.swp
*~
